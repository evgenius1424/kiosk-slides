{
  "name": "kiosk-slides",
  "version": "0.1.0",
  "private": true,
  "description": "Describe your talk to AI and get a clean, finished presentation in seconds, as HTML slides built for screen sharing and meeting-room TVs.",
  "keywords": [
    "presentation",
    "slides",
    "ai",
    "markdown",
    "html-slides",
    "agent-skill"
  ],
  "homepage": "https://kiosk-slides.com",
  "bugs": "https://github.com/evgenius1424/kiosk-slides/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgenius1424/kiosk-slides.git"
  },
  "license": "MIT",
  "author": "Evgenii Glinskii (https://github.com/evgenius1424)",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "build:skills": "node scripts/build-skills.mjs",
    "check:flows": "node scripts/check-flows.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@tanstack/react-query": "^5.105.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "1.6.1",
    "lucide-react": "^1.16.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19",
    "react-dom": "^19",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.10",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^5.0.3"
  }
}
